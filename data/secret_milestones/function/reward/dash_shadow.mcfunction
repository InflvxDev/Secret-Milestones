# Recompensa del hito 11. Si la cambias, cambia también su item en milestone/registry.
# custom_data es lo que reconoce item/dash_shadow (detecta el doble espacio).
# El encantamiento secret_milestones:dash es el que empuja (enchantment/dash.json): sin él no hay dash.
give @s minecraft:netherite_leggings[minecraft:custom_name={text:"Dash Shadow",color:"dark_gray",italic:false},minecraft:lore=[{text:"Doble espacio + WASD: dash",color:"gray",italic:false}],minecraft:enchantments={"minecraft:protection":4,"minecraft:fire_protection":4,"minecraft:blast_protection":4,"minecraft:projectile_protection":4,"minecraft:swift_sneak":5,"minecraft:thorns":3,"secret_milestones:dash":1},minecraft:unbreakable={},minecraft:custom_data={secret_milestones:"dash_shadow"}] 1
