# Recompensa del hito 10. Si la cambias, cambia también su item en milestone/registry.
# Densidad y Brecha juntos no se pueden en survival: solo salen por comando.
# El encantamiento secret_milestones:mace_chaos es el que lanza a los mobs (enchantment/mace_chaos.json).
give @s minecraft:mace[minecraft:custom_name={text:"Españita Chaos Mace",color:"#7FE9FF",italic:false},minecraft:enchantments={"minecraft:density":5,"minecraft:breach":4,"minecraft:wind_burst":3,"secret_milestones:mace_chaos":1},minecraft:unbreakable={},minecraft:custom_data={secret_milestones:"chaos_mace"}] 1
