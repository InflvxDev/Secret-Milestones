# Registro de hitos: el panel se arma solo con esta lista (un hito = un bloque, sin tocar admin/).
#   id     = carpeta en function/milestone/ (necesita complete y progress)
#   reward = función en function/reward/
#   item   = vista previa, igual a lo que da reward
#   sprite = ícono del botón (atlas de ítems)
#   goal   = condición en una línea, rules = la letra chica
data modify storage secret_milestones:db milestones set value []

data modify storage secret_milestones:db milestones append value {id:"stone_1m",reward:"chunk_destroyer",name:"Chunk Destroyer Infinitum",color:"red",sprite:"item/netherite_pickaxe",goal:"Minar 1.000.000 de piedra",rules:"Cada zona de 16x16x16 cuenta hasta 5500. Mucho fuera de cupo suele ser un generador.",item:{id:"minecraft:netherite_pickaxe",components:{"minecraft:custom_name":{text:"Chunk Destroyer Infinitum",color:"red",italic:false},"minecraft:enchantments":{"minecraft:efficiency":10,"minecraft:silk_touch":1},"minecraft:unbreakable":{}}}}

data modify storage secret_milestones:db milestones append value {id:"bow_all",reward:"chaos_bow",name:"Españita Chaos Bow",color:"dark_purple",sprite:"item/bow",goal:"Matar con arco a todo tipo de mobs",rules:"Enderman: con flecha y montado. Breeze y Wither: último golpe con el arco en la mano. No entran Creaking, Giant ni Illusioner.",item:{id:"minecraft:bow",components:{"minecraft:custom_name":{text:"Españita Chaos Bow",color:"dark_purple",italic:false},"minecraft:enchantments":{"minecraft:power":5,"minecraft:unbreaking":3,"minecraft:infinity":1,"minecraft:mending":1}}}}

data modify storage secret_milestones:db milestones append value {id:"debris_beacon",reward:"debris_finder",name:"Debris Finder",color:"gold",sprite:"item/netherite_scrap",goal:"Minar 5904 de ancient debris: un beacon de netherita completo",rules:"Agachado con él en la mano: radar de 8 bloques. En la mano da Resistencia al fuego. El debris colocado no cuenta al minarlo.",item:{id:"minecraft:netherite_pickaxe",components:{"minecraft:custom_name":{text:"Debris Finder",color:"gold",italic:false},"minecraft:enchantments":{"minecraft:efficiency":5,"minecraft:fortune":5},"minecraft:unbreakable":{},"minecraft:custom_data":{secret_milestones:"debris_finder"}}}}

data modify storage secret_milestones:db milestones append value {id:"treasure_500",reward:"abyss_hook",name:"Anzuelo del Abismo",color:"blue",sprite:"item/fishing_rod",goal:"Pescar 500 tesoros en aguas abiertas",rules:"Con esta caña salen tesoros sin aguas abiertas, como en las fish farms antiguas. Los de agua cerrada no suman para el hito.",item:{id:"minecraft:fishing_rod",components:{"minecraft:custom_name":{text:"Anzuelo del Abismo",color:"blue",italic:false},"minecraft:enchantments":{"minecraft:luck_of_the_sea":5,"minecraft:lure":3},"minecraft:unbreakable":{},"minecraft:custom_data":{secret_milestones:"abyss_hook"}}}}

data modify storage secret_milestones:db milestones append value {id:"farlands",reward:"farlands_explorer",name:"Farlands Explorer",color:"aqua",sprite:"item/netherite_boots",goal:"Llegar al borde del mundo: las Farlands",rules:"A 29.999.900 bloques en X o Z, en el Overworld o el End. El Nether no cuenta. Puestas dan Velocidad II.",item:{id:"minecraft:netherite_boots",components:{"minecraft:custom_name":{text:"Farlands Explorer",color:"aqua",italic:false},"minecraft:enchantments":{"minecraft:protection":4,"minecraft:fire_protection":4,"minecraft:blast_protection":4,"minecraft:projectile_protection":4,"minecraft:feather_falling":4,"minecraft:thorns":3,"minecraft:depth_strider":3,"minecraft:soul_speed":3,"minecraft:swift_sneak":3},"minecraft:unbreakable":{},"minecraft:custom_data":{secret_milestones:"farlands_explorer"}}}}

data modify storage secret_milestones:db milestones append value {id:"redstone_1000",reward:"red_power",name:"RedKeyStone",color:"red",sprite:"item/redstone",goal:"Craftear 1000 de cada componente de redstone",rules:"16 componentes, sin el bloque de redstone. El crafter (bloque) y el creativo no suman. La llave gira repetidores, comparadores, pistones, observadores, dispensadores, droppers y tolvas.",item:{id:"minecraft:carrot_on_a_stick",components:{"minecraft:custom_name":{text:"RedKeyStone",color:"red",italic:false},"minecraft:item_model":"minecraft:redstone_torch","minecraft:enchantment_glint_override":true,"minecraft:lore":[{text:"Clic derecho: gira el bloque",color:"gray",italic:false},{text:"Agachado en repetidores, comparadores y contenedores",color:"gray",italic:false}],"minecraft:tooltip_display":{hidden_components:["minecraft:unbreakable"]},"minecraft:unbreakable":{},"minecraft:custom_data":{secret_milestones:"red_power"}}}}

data modify storage secret_milestones:db milestones append value {id:"life_1000",reward:"kars_totem",name:"Kars Totem",color:"gold",sprite:"item/totem_of_undying",goal:"Sobrevivir 1000 días del juego sin morir (tiempo jugado)",rules:"Morir reinicia la cuenta. Solo suma conectado, vivo, en survival o aventura y sin AFK (2 min sin girar la cámara pausa la cuenta). El tótem vuelve cada vez que salva, pero no del vacío ni de /kill. En la segunda mano da Regeneración I.",item:{id:"minecraft:totem_of_undying",components:{"minecraft:custom_name":{text:"Kars Totem",color:"gold",italic:false},"minecraft:lore":[{text:"I am the Ultimate Life Form",color:"light_purple",italic:true}],"minecraft:enchantment_glint_override":true,"minecraft:custom_data":{secret_milestones:"kars_totem"}}}}

data modify storage secret_milestones:db milestones append value {id:"log_100k",reward:"woodozer",name:"Woodozer",color:"#8B5A2B",sprite:"item/netherite_axe",goal:"Talar 100.000 troncos",rules:"Troncos y tallos del Nether. Cada zona de 16x16x16 cuenta hasta 1000. Tala el árbol entero si toca hojas naturales; agachado, un solo tronco.",item:{id:"minecraft:netherite_axe",components:{"minecraft:custom_name":{text:"Woodozer",color:"#8B5A2B",italic:false},"minecraft:enchantments":{"minecraft:sharpness":5,"minecraft:efficiency":5,"minecraft:fortune":3},"minecraft:unbreakable":{},"minecraft:custom_data":{secret_milestones:"woodozer"}}}}

data modify storage secret_milestones:db milestones append value {id:"deep_mine",reward:"deepmine_crown",name:"DeepMine Crown",color:"dark_aqua",sprite:"item/netherite_helmet",goal:"Minar en las cuevas profundas: deepslate, tuff y todas las menas de deepslate",rules:"Menas: con Toque de seda no cuentan (sí al romperlas después sin él). Deepslate y tuff: cupo por zona de 16x16x16 (5500 y 2000). Metas: 100.000 deepslate, 25.000 tuff, 3500 diamante, 5000 redstone, 3000 oro, 3000 hierro, 2000 lapislázuli y 1000 cobre. Puesta da Visión nocturna e inmunidad a la Oscuridad.",item:{id:"minecraft:netherite_helmet",components:{"minecraft:custom_name":{text:"DeepMine Crown",color:"dark_aqua",italic:false},"minecraft:enchantments":{"minecraft:protection":4,"minecraft:fire_protection":4,"minecraft:blast_protection":4,"minecraft:projectile_protection":4,"minecraft:respiration":3,"minecraft:aqua_affinity":1,"minecraft:thorns":3},"minecraft:unbreakable":{},"minecraft:custom_data":{secret_milestones:"deepmine_crown"}}}}

data modify storage secret_milestones:db milestones append value {id:"soil_250k",reward:"terra_magnet",name:"Terra Magnet",color:"#7CBD3B",sprite:"item/netherite_shovel",goal:"Excavar 250.000 bloques blandos",rules:"Tierra, pasto, podzol, micelio, caminos, arena, grava, arcilla, nieve, soul sand, soul soil y barro. Cada zona de 16x16x16 cuenta hasta 2000. Lo que excava con ella va directo al inventario.",item:{id:"minecraft:netherite_shovel",components:{"minecraft:custom_name":{text:"Terra Magnet",color:"#7CBD3B",italic:false},"minecraft:enchantments":{"minecraft:efficiency":5,"minecraft:silk_touch":1},"minecraft:unbreakable":{},"minecraft:custom_data":{secret_milestones:"terra_magnet"}}}}

data modify storage secret_milestones:db milestones append value {id:"movement",reward:"dash_shadow",name:"Dash Shadow",color:"dark_gray",sprite:"item/netherite_leggings",goal:"Recorrer 300 km agachado, 1000 km corriendo y saltar 100.000 veces",rules:"Agachado: solo con agacharse y WASD apretadas. Corriendo: solo apretando W. Saltos: cada zona de 16x16x16 cuenta hasta 500. Sin AFK (2 min sin girar la cámara pausa). Doble espacio con WASD: dash hacia esa dirección, cada 1,5 s.",item:{id:"minecraft:netherite_leggings",components:{"minecraft:custom_name":{text:"Dash Shadow",color:"dark_gray",italic:false},"minecraft:lore":[{text:"Doble espacio + WASD: dash",color:"gray",italic:false}],"minecraft:enchantments":{"minecraft:protection":4,"minecraft:fire_protection":4,"minecraft:blast_protection":4,"minecraft:projectile_protection":4,"minecraft:swift_sneak":5,"minecraft:thorns":3,"secret_milestones:dash":1},"minecraft:unbreakable":{},"minecraft:custom_data":{secret_milestones:"dash_shadow"}}}}

data modify storage secret_milestones:db milestones append value {id:"hurt",reward:"aegis_heart",name:"Aegis Heart",color:"yellow",sprite:"item/netherite_chestplate",goal:"Aguantar daño: 50.000 corazones de golpes, 25.000 de proyectiles, 10.000 de explosiones, 10.000 de fuego y lava y 5.000 de jefes",rules:"Cuenta el daño antes de la armadura. Solo de mobs: PvP, TNT, camas y end crystals no. Lo bloqueado con escudo no cuenta. Cada zona de 16x16x16 cuenta hasta 250 corazones por tipo (50 de fuego); los jefes no tienen cupo. Puesta da Resistencia II e inmunidad al Wither.",item:{id:"minecraft:netherite_chestplate",components:{"minecraft:custom_name":{text:"Aegis Heart",color:"yellow",italic:false},"minecraft:enchantments":{"minecraft:protection":4,"minecraft:fire_protection":4,"minecraft:blast_protection":4,"minecraft:projectile_protection":4,"minecraft:thorns":3},"minecraft:unbreakable":{},"minecraft:custom_data":{secret_milestones:"aegis_heart"}}}}

data modify storage secret_milestones:db milestones append value {id:"armor_set",reward:"chaos_sword",name:"Españita Chaos Sword",color:"red",sprite:"item/netherite_sword",goal:"Conseguir las 4 piezas de armadura secretas",rules:"Cuenta haber cobrado los hitos de la DeepMine Crown, la Aegis Heart, los Dash Shadow y las Farlands Explorer: perder una pieza no lo quita. En la mano da Fuerza II. Cada golpe tiene una probabilidad muy baja de dar Wither, Náusea, Ceguera, Lentitud o Debilidad: empieza en 0,2% y sube 0,2% por golpe hasta 5%, y al salir vuelve a empezar.",item:{id:"minecraft:netherite_sword",components:{"minecraft:custom_name":{text:"Españita Chaos Sword",color:"red",italic:false},"minecraft:enchantments":{"minecraft:sharpness":5,"minecraft:smite":5,"minecraft:bane_of_arthropods":5,"minecraft:looting":5,"minecraft:sweeping_edge":5,"secret_milestones:chaos":1},"minecraft:unbreakable":{},"minecraft:custom_data":{secret_milestones:"chaos_sword"}}}}

data modify storage secret_milestones:db milestones append value {id:"harvest",reward:"thorfinn_harvest",name:"Thorfinn Harvest",color:"gold",sprite:"item/netherite_hoe",goal:"Cosechar cultivos maduros: 10.000 de trigo, zanahoria, papa, remolacha y verruga, y 5.000 melones y calabazas",rules:"Solo cuenta lo maduro (se mira lo que soltó). Melones y calabazas: solo los que crecieron de su tallo; los colocados de decoración no cuentan ni restan. Sin AFK y no en creativo. Clic derecho en un cultivo: la azada sale como un boomerang, cosecha en cadena los cultivos de al lado (hasta 12 bloques), replanta con sus semillas y vuelve con lo cosechado. No toca los melones ni calabazas de decoración.",item:{id:"minecraft:netherite_hoe",components:{"minecraft:custom_name":{text:"Thorfinn Harvest",color:"gold",italic:false},"minecraft:lore":[{text:"Clic derecho en un cultivo: lánzala",color:"gray",italic:false},{text:"\"No tengo enemigos.\"",color:"dark_gray",italic:true}],"minecraft:enchantments":{"minecraft:fortune":5,"minecraft:efficiency":5},"minecraft:unbreakable":{},"minecraft:custom_data":{secret_milestones:"thorfinn_harvest"},"minecraft:consumable":{consume_seconds:100000,animation:"none",has_consume_particles:false},"minecraft:use_effects":{can_sprint:true,speed_multiplier:1.0}}}}

data modify storage secret_milestones:db milestones append value {id:"tool_set",reward:"chaos_mace",name:"Españita Chaos Mace",color:"#7FE9FF",sprite:"item/mace",goal:"Conseguir las 4 herramientas secretas",rules:"Cuenta haber cobrado los hitos de un pico (Chunk Destroyer o Debris Finder), el Woodozer, la Terra Magnet y la Thorfinn Harvest: perder una no lo quita. Cada golpe pesado (cayendo 1,5 bloques o más) puede lanzar por el aire a los mobs a 5 bloques: empieza en 1,5% y sube 1,5% por golpe hasta 25%, y al salir vuelve a empezar.",item:{id:"minecraft:mace",components:{"minecraft:custom_name":{text:"Españita Chaos Mace",color:"#7FE9FF",italic:false},"minecraft:enchantments":{"minecraft:density":5,"minecraft:breach":4,"minecraft:wind_burst":3,"secret_milestones:mace_chaos":1},"minecraft:unbreakable":{},"minecraft:custom_data":{secret_milestones:"chaos_mace"}}}}

data modify storage secret_milestones:db milestones append value {id:"feast_500",reward:"eternal_feast",name:"Eternal Feast",color:"#FFA94D",sprite:"item/rabbit_stew",goal:"Comer 500 de cada comida del juego",rules:"40 comidas (cada porción de torta cuenta), sin la manzana de oro encantada. En creativo no suma. El Eternal Feast no se gasta: llena el hambre y la saturación y quita los efectos negativos, con 15 s de espera. A veces (2%) bendice con un efecto más fuerte que cualquier poción por 1 minuto.",item:{id:"minecraft:rabbit_stew",components:{"minecraft:custom_name":{text:"Eternal Feast",color:"#FFA94D",italic:false},"minecraft:lore":[{text:"Servido a quien probó cada sabor del mundo.",color:"gray",italic:true},{text:"Ni el hambre de mil inviernos podría vaciarlo.",color:"gray",italic:true}],"minecraft:enchantment_glint_override":true,"minecraft:food":{nutrition:20,saturation:20.0f,can_always_eat:true},"minecraft:consumable":{consume_seconds:1.6f,animation:"eat",sound:"minecraft:entity.generic.eat",has_consume_particles:true,on_consume_effects:[{type:"minecraft:remove_effects",effects:["minecraft:slowness","minecraft:mining_fatigue","minecraft:instant_damage","minecraft:nausea","minecraft:blindness","minecraft:hunger","minecraft:weakness","minecraft:poison","minecraft:wither","minecraft:levitation","minecraft:unluck","minecraft:darkness","minecraft:infested","minecraft:oozing","minecraft:weaving","minecraft:wind_charged"]}]},"minecraft:use_cooldown":{seconds:15.0f,cooldown_group:"secret_milestones:eternal_feast"},"minecraft:custom_data":{secret_milestones:"eternal_feast"}}}}

data modify storage secret_milestones:db milestones append value {id:"weapon_set",reward:"chaos_trident",name:"Españita Chaos Trident",color:"#4D8CFF",sprite:"item/trident",goal:"Conseguir las 3 armas secretas",rules:"Cuenta haber cobrado los hitos del Españita Chaos Bow, la Españita Chaos Sword y la Españita Chaos Mace: perder una no lo quita. Lanzado, cada impacto en un mob puede invocarle un rayo aunque no haya tormenta: empieza en 2% y sube 2% por impacto hasta 30%, y al salir vuelve a empezar. Agachado al lanzarlo sale con Propulsión aunque no llueva, cada 3 s.",item:{id:"minecraft:trident",components:{"minecraft:custom_name":{text:"Españita Chaos Trident",color:"#4D8CFF",italic:false},"minecraft:enchantments":{"minecraft:loyalty":3,"minecraft:channeling":1,"minecraft:impaling":5,"minecraft:looting":5,"secret_milestones:trident_chaos":1},"minecraft:unbreakable":{},"minecraft:custom_data":{secret_milestones:"chaos_trident"}}}}
