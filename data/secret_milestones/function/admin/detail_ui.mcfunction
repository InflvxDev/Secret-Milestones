# Interno: {get, test, progress, stat, num, back} las acciones de un hito
# after_action close (no wait_for_response): con "Probar hito" el servidor no manda otro diálogo, y el
# juego se quedaba en "Esperando respuesta" unos segundos tapando el título. Los demás botones abren el siguiente.
$data modify storage secret_milestones:tmp ui set value {type:"minecraft:multi_action",title:{text:"",bold:true},body:[{type:"minecraft:item",item:{id:"minecraft:paper"},description:{width:240,contents:{text:"",color:"white"}}},{type:"minecraft:plain_message",width:310,contents:{text:"",color:"gray"}}],columns:1,pause:false,after_action:"close",actions:[{width:200,label:{text:"Obtener recompensa",color:"green"},tooltip:{text:"Te da solo el ítem. No cuenta como conseguir el hito."},action:{type:"minecraft:run_command",command:"trigger sm.admin set $(get)"}},{width:200,label:{text:"Probar hito",color:"gold"},tooltip:{text:"Cierra el panel y te muestra lo que verá el jugador: título, sonido, partículas e ítem. No cuenta como conseguirlo."},action:{type:"minecraft:run_command",command:"trigger sm.admin set $(test)"}},{width:200,label:{text:"Ver progreso",color:"aqua"},tooltip:{text:"Cuánto lleva cada jugador"},action:{type:"minecraft:run_command",command:"trigger sm.admin set $(progress)"}},{width:200,label:{text:"Activar estadística",color:"light_purple"},tooltip:{text:"Muestra este hito en StatsCraft como «Hito Secreto #$(num)»: cada jugador ve cuánto lleva y el ranking, pero la meta sale como ??? y nunca el nombre de la recompensa."},action:{type:"minecraft:run_command",command:"trigger sm.admin set $(stat)"}}],exit_action:{label:"Volver",action:{type:"minecraft:run_command",command:"trigger sm.admin set $(back)"}}}
